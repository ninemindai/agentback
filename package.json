{
  "name": "agentback",
  "version": "0.0.1",
  "private": true,
  "description": "AI-native API/MCP framework for the agent era, built with agents, for agents",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "tsc -b && pnpm -r --no-sort run build:client",
    "build:watch": "tsc -b --watch",
    "clean": "tsc -b --clean && pnpm -r --no-sort exec rm -rf dist",
    "typecheck:client": "pnpm -r --no-sort --if-present run typecheck:client",
    "verify": "pnpm konsistent && pnpm check:generated && pnpm lint && pnpm build && pnpm typecheck:client && pnpm test && node scripts/validate-templates.mjs && pnpm build:site",
    "test": "vitest run",
    "test:watch": "vitest",
    "konsistent": "konsistent",
    "check:generated": "node packages/console-chat/scripts/gen-framework-guide.mjs --check",
    "lint": "eslint . && prettier --check \"**/*.{ts,json,md}\"",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,json,md}\"",
    "agents-md": "node scripts/gen-agents-md.mjs",
    "build:site": "node website/build.mjs"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  },
  "devDependencies": {
    "@types/node": "~22.18.13",
    "@typescript-eslint/eslint-plugin": "~8.70.1",
    "@typescript-eslint/parser": "~8.70.1",
    "eslint": "~10.11.0",
    "konsistent": "1.0.0-beta.10",
    "marked": "^18.0.14",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@~7.0.2",
    "vitest": "~5.0.1"
  },
  "license": "MIT",
  "copyright.owner": "NineMind, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninemindai/agentback.git"
  },
  "homepage": "https://agentback.dev",
  "bugs": "https://github.com/ninemindai/agentback/issues"
}
