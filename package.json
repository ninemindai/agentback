{
  "name": "agentback",
  "version": "0.0.1",
  "private": true,
  "description": "AI-native API/MCP framework for the agent era, built with agents, for agents",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "tsc -b && pnpm -r run build:client",
    "build:watch": "tsc -b --watch",
    "clean": "tsc -b --clean && pnpm -r exec rm -rf dist",
    "typecheck:client": "pnpm -r --if-present run typecheck:client",
    "verify": "pnpm konsistent && pnpm build && pnpm typecheck:client && pnpm test && node scripts/validate-templates.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "konsistent": "konsistent",
    "lint": "eslint . && prettier --check \"**/*.{ts,json,md}\"",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,json,md}\"",
    "agents-md": "node scripts/gen-agents-md.mjs"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "~8.63.0",
    "@typescript-eslint/parser": "~8.63.0",
    "eslint": "~10.6.0",
    "konsistent": "1.0.0-beta.3",
    "marked": "^18.0.5",
    "prettier": "^3.9.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@~7.0.2",
    "vitest": "~4.1.10"
  },
  "license": "MIT",
  "copyright.owner": "NineMind, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninemindai/agentback.git"
  },
  "homepage": "https://agentback.dev",
  "bugs": "https://github.com/ninemindai/agentback/issues"
}
